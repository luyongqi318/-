# 复制成 .env 后按需修改，然后 docker compose up -d
# 登录账号（务必改掉默认密码）
HR_USER=hr
HR_PASS=请改成你的强密码

# 会话签名密钥：随便一串 32 位以上随机字符
AUTH_SECRET=请改成32位以上随机字符串

# 模型（不填也能跑，页面「系统设置」里也可以填）
DEEPSEEK_API_KEY=
AGENT_MODEL=deepseek-flash
AGENT_BASE_URL=https://api.deepseek.com

# 邮件（可选，填了就能真发，不填进发件箱）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
